# SMTP Configuration (use Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# JWT Secret (change this!)
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# Allowed email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=vit.edu

# Dev mode: when true, OTP is printed to console if SMTP is not configured
DEV_MODE=true

# Admin account (created by seed script)
ADMIN_EMAIL=admin@vit.edu
ADMIN_PASSWORD=Admin@123

# Server port
PORT=3001

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
